{
  "name": "voice-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "mock": "npm run mock -w server",
    "typecheck": "npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
